# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# MUST point at a database SEPARATE from mj-digital-backend's database.
# Same MongoDB cluster is fine — just a different database name, e.g.:
#   mongodb+srv://user:pass@cluster.mongodb.net/mj_digital_cms
# Do NOT reuse mj-digital-backend's database name here.
DATABASE_URI=

# mj-digital-services calls this CMS's REST/GraphQL API via NEXT_PUBLIC_CMS_URL,
# set on mj-digital-services's own side (see its .env.local) — not a var on
# this repo.

# Same Cloudflare R2 account/bucket as mj-digital-backend (see its .env /
# src/config/environment.js for the actual values) — media uploads here are
# scoped to their own `cms-media/` prefix inside that bucket, so they never
# collide with mj-digital-backend's own upload prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mj-digital-media
R2_PUBLIC_URL=

# On-demand ISR revalidation on mj-digital-services when a post is published/
# updated/deleted. MUST be the exact same REVALIDATE_SECRET value already
# configured on mj-digital-services (see its own .env.local / src/app/api/revalidate/route.ts)
# — this calls that same endpoint, not a new one.
FRONTEND_URL=https://www.mjdigitalservices.com
REVALIDATE_SECRET=

# Authenticates GET /api/payload-jobs/run for the external cron
# (mj-digital-backend's own node-cron, see its triggerCmsScheduledPublish.job.js)
# that triggers scheduled-publish checks. Generate with: openssl rand -hex 24
# Must match mj-digital-backend's CMS_CRON_SECRET env var exactly.
CRON_SECRET=
